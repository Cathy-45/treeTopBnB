PORT=8000
DB_FILE=db/dev.db
NODE_ENV=development
SCHEMA=findbnb_schema
JWT_EXPIRES_IN=604800
JWT_SECRET=xlksTfmQg/ZefA

# Frontend URL Flutterwave redirects the guest back to after checkout
FRONTEND_URL=http://localhost:5173

# PawaPay (active gateway, mobile money only) — direct-charge deposits API
# (POST /v2/deposits), same pattern as the proven FarmLink/AgriConnect
# integration on this same EC2 backend: phone number + provider are
# collected in-app, guest gets a PIN prompt on their own phone, no redirect.
# Get PAWAPAY_API_TOKEN from the PawaPay Dashboard (dashboard.sandbox.pawapay.io
# for testing, dashboard.pawapay.io once live) under API Tokens. Also set your
# Deposit callback URL there to <backend URL>/api/webhooks/pawapay.
# Booking creation still works with this unset; it just skips attempting a
# real charge until it's added. (Note: FarmLink's own .env calls this same
# kind of token PAWAPAY_SANDBOX_TOKEN — different var name, same idea, kept
# separate since these are independent projects/deployments.)
PAWAPAY_API_TOKEN=
PAWAPAY_ENV=sandbox
PAWAPAY_COUNTRY=ZMB

# Flutterwave (payments, on hold — Zambia live processing needs $5M+/year
# volume per their sales team, so this isn't wired as the active gateway
# right now, but the code is left in place for when card support returns).
# Get these from the Flutterwave dashboard (Settings -> API Keys for the
# secret/public keys, Settings -> Webhooks for the hash).
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_CURRENCY=ZMW
